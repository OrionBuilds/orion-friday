{
  "name": "error_rate",
  "description": "How often FRIDAY's own machinery has been failing: error/warn counts from her event log and per-tool failure rates from telemetry, over a window (default 24h). Use for 'are you healthy', 'anything failing', 'what's your error rate', and as the error-rate step after a deploy. Honest scope: FRIDAY's own logs, NOT client-site errors — those are site_health/read_deploys. Read-only.",
  "input_schema": {
    "type": "object",
    "properties": {

exports[`tool: qa_check_deploy > golden surface 1`] = `
{
  "name": "qa_check_deploy",
  "description": "Verify a deployed site after (or before) a ship: fetches the production URL plus any per-project QA URLs, checks HTTP status, latency, and expected page content, and reads the TLS certificate's expiry. THE follow-up to deploy and rollback_deploy — 'did the deploy actually work', 'is the site serving right', 'check the cert'. HTTP-level only (no browser), read-only, safe anytime.",
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "description": "Project name, id, or a bare domain/URL to check directly."
      }
    },
    "required": [
      "project"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;


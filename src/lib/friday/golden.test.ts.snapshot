`;

exports[`tool: rollback_deploy > golden surface 1`] = `
{
  "name": "rollback_deploy",
  "description": "Publish a PREVIOUS Netlify deploy again — the undo for a bad production deploy (site serves the old build immediately). Changes what the client's site serves, so it always needs Jordan's approval. Use read_deploys first to pick the deploy id.",
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "description": "Project name, id, or site/domain."
      },
      "deploy_id": {
        "type": "string",
        "description": "The deploy to restore (from read_deploys). Omit to restore the most recent 'ready' deploy before the current one."
      }
    },
    "required": [
      "project"
    ]
  },
  "actionClass": "deploy",
  "reversible": false,
  "speed": "fast"
}
`;

exports[`tool: run_subagent > golden surface 1`] = `
{
  "name": "run_subagent",
  "description": "Hand ONE task to a member of your own department and return their report: builder (implementation), qa-e2e (verification/site health), devops-deploy (ships/rollbacks — still gated), reviewer (second opinions), project-manager (status/coordination), client-comms (gated client updates), docs-sop (documentation). Each runs with its own narrow tool set; anything irreversible inside their run still queues for Jordan.",
  "input_schema": {
    "type": "object",
    "properties": {
      "subagent": {
        "type": "string",
        "enum": [
          "builder",
          "qa-e2e",
          "devops-deploy",
          "reviewer",
          "project-manager",
          "client-comms",
          "docs-sop"
        ]
      },
      "task": {
        "type": "string",
        "description": "The single task, fully stated — the specialist sees only this and its own tools."
      }
    },
    "required": [
      "subagent",
      "task"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: share_doc > golden surface 1`] = `
{
  "name": "share_doc",
  "description": "Give a named email address access to a Google Doc or Drive file — the doc becomes visible to them the moment this runs. Client-facing, so it ALWAYS queues for Jordan's approval; never assume it went through. Use after create_doc or drive_search when Jordan says to share/send a doc to someone. The undo is unshare_doc.",
  "input_schema": {
    "type": "object",
    "properties": {
      "doc": {
        "type": "string",
        "description": "The doc/file id, or its full Docs/Drive URL."
      },
      "email": {
        "type": "string",
        "description": "Who gets access. A real address — from find_contact if you only have a name."
      },
      "role": {
        "type": "string",
        "enum": [
          "reader",
          "commenter",
          "writer"
        ],
        "description": "Access level. Default reader."
      }
    },
    "required": [
      "doc",
      "email"
    ]
  },
  "actionClass": "client_notify",
  "reversible": false,
  "speed": "fast"
}
`;


exports[`tool: client_health > golden surface 1`] = `
{
  "name": "client_health",
  "description": "The per-client health detail — tasks, deliverables, uptime and deploy state for each active client.",
  "input_schema": {
    "type": "object",
    "properties": {
      "client": {
        "type": "string",
        "description": "Filter to one client by name."
      }
    }
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: convene_meeting > golden surface 1`] = `
{
  "name": "convene_meeting",
  "description": "Call a meeting with Jordan in the Office War Room — use when something needs live discussion rather than a message: a decision with tradeoffs, a problem spanning agents, or news that warrants talking through. Creates the room with your topic on the record and pings Jordan with the link. Also use when Jordan says 'set up a meeting about X'.",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Short meeting title."
      },
      "topic": {
        "type": "string",
        "description": "Your opening statement — why you called this and what needs deciding."
      },
      "include": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "clara"
          ]
        },
        "description": "Sibling agents who should be in the room too."
      }
    },
    "required": [
      "title",
      "topic"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "fast"
}
`;

exports[`tool: create_doc > golden surface 1`] = `
{
  "name": "create_doc",
  "description": "Write content into a new Google Doc and return the link — proposals, SOWs, briefs, recaps, meeting notes. Creates a private doc; it does NOT share or send it to anyone.",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Document title."
      },
      "content": {
        "type": "string",
        "description": "Full body text of the document."
      }
    },
    "required": [
      "title",
      "content"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: create_task_from_meeting > golden surface 1`] = `
{
  "name": "create_task_from_meeting",
  "description": "Turn a closed War Room meeting into committed work: reads the archived transcript from the office vault, pulls out the action items assigned to FRIDAY, and files each as a real task. Use after a meeting — 'file my action items from the standup', 'pick up what I owe from that war room' — or when Jordan says items from a meeting should be on the board. Names the meeting loosely (title words or date); no name = the most recent one. Creates internal task rows only — nothing ships, nothing reaches a client.",
  "input_schema": {
    "type": "object",
    "properties": {
      "meeting": {
        "type": "string",
        "description": "Which meeting — title words, slug, or date (e.g. 'war room', '2026-08-13'). Omit for the latest."
      },
      "project": {
        "type": "string",
        "description": "Project to file the tasks on. Call list_projects if unsure; omit for the active project."
      }
    }
  },
  "actionClass": "task_dispatch",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: deep_work > golden surface 1`] = `
{
  "name": "deep_work",
  "description": "THE tool for any request whose answer is a document, audit, plan, or report — if Jordan asks for something that would take a person hours at a desk, this is it. Triggers include: 'I need a technical audit of <system/site>', 'put together an architecture doc/proposal/migration plan', 'build me a report/runbook/spreadsheet', 'research X and write it up', or any ask for 'docs', 'documents', or 'deliverables'. Runs autonomously in the background — researches the subject, builds branded documents (PDF/DOCX/XLSX), files them in the shared drive, and pings Jordan with links plus anything needing their call. Do NOT fall through to the planner for these — it narrates document work without producing files. NOT for quick questions, status reads, or code dispatch (the task/run pipeline owns coding work).",
  "input_schema": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string",
        "description": "The full work request in Jordan's words, including the target (site/system/client) and the deliverables wanted."
      },
      "client": {
        "type": "string",
        "description": "Client name, when the work is for a known client."
      }
    },
    "required": [
      "task"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: delegate_to_agent > golden surface 1`] = `
{
  "name": "delegate_to_agent",
  "description": "Hand a piece of work to CLARA (Jordan's calendar, inbox, contacts, scheduling, personal matters — she is the ONLY agent with that access). Use whenever a request is clearly hers rather than FRIDAY's — e.g. 'schedule a call with the client'. Reports what actually came back, so the handoff is provable.",
  "input_schema": {
    "type": "object",
    "properties": {
      "agent": {
        "type": "string",
        "enum": [
          "clara"
        ]
      },
      "task": {
        "type": "string",
        "description": "The request, in plain words, with enough context to act on."
      }
    },
    "required": [
      "agent",
      "task"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;


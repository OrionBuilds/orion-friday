exports[`tool: orchestrator_review > golden surface 1`] = `
{
  "name": "orchestrator_review",
  "description": "Run the read-only multi-engine review orchestrator against a client project checkout on this machine (Claude code review + test run + git/GitHub check, plus Codex and Antigravity second opinions), or read back the latest report. Use for 'run an orchestrator review on X', 'audit X with all the engines', 'review the FRIDAY repo', 'show me the latest orchestrator report'. Runs in the background (5-10 min) and writes to the orchestrator's reports/<project>/ folder; nothing in the project is modified. NOT for deploying, fixing, or dispatching work — it only reports.",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "run",
          "latest"
        ],
        "description": "run = start a fresh review; latest = summarize the newest report."
      },
      "project": {
        "type": "string",
        "description": "Folder under the client-projects root (e.g. FRIDAY, Clients/Globex, GitHub/globex-fl) or a registered project name. Default FRIDAY."
      }
    },
    "required": [
      "action"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "slow"
}
`;

exports[`tool: project_status > golden surface 1`] = `
{
  "name": "project_status",
  "description": "What is happening across the agency right now: active projects, open tasks, running work, and anything awaiting Jordan's approval. Use for 'what's going on', 'where are we', 'status', 'what's in flight'. Pass \`project\` for one project ('how is Globex going?') to get its stage, health, recent activity with provenance, blockers, next steps and anything waiting on Jordan.",
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "description": "Project (or client) name or id for a single-project answer. Omit for the agency-wide view."
      }
    }
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "fast"
}
`;


`;

exports[`tool: recall_sessions > golden surface 1`] = `
{
  "name": "recall_sessions",
  "description": "Search past conversations — full-text over every prior chat session (owner and client channels), months back. Use when a request references something discussed before: 'what did we decide about X', 'didn't we cover this already', 'find that thing the client asked for last month', or when today's ask clearly continues earlier work you don't have in context. Returns matching moments with their session date and topic. Read-only; searches only your own history.",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "What to look for — plain keywords work best (e.g. 'staging rollout plan')."
      },
      "limit": {
        "type": "number",
        "description": "Max matches to return (default 8)."
      }
    },
    "required": [
      "query"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "fast"
}
`;


exports[`tool: tail_logs > golden surface 1`] = `
{
  "name": "tail_logs",
  "description": "Read the last N lines of one of FRIDAY's own logs: 'app' (the server's stdout), 'service' (the supervisor loop), 'watchdog', 'backup', 'orchestration' (her event log — runs, approvals, failures), or 'telemetry' (per-tool call records). THE read for 'why did you crash', 'what happened overnight', 'show me the log'. These are FRIDAY's logs, not client-site logs — deploys are read_deploys, sites are site_health. Read-only.",
  "input_schema": {
    "type": "object",
    "properties": {
      "log": {
        "type": "string",
        "enum": [
          "app",
          "service",
          "watchdog",
          "backup",
          "orchestration",
          "telemetry"
        ],
        "description": "Which log."
      },
      "lines": {
        "type": "number",
        "description": "How many lines from the end. Default 40, max 200."
      }
    },
    "required": [
      "log"
    ]
  },
  "actionClass": "other",
  "reversible": true,
  "speed": "fast"
}
`;

exports[`tool: unshare_doc > golden surface 1`] = `
{
  "name": "unshare_doc",
  "description": "Take a person's access to a Google Doc or Drive file away again — the undo for share_doc. Use when a doc was shared with the wrong person, the wrong version went out, or access should end. Changes what a client can see, so it queues for Jordan's approval. Note what it can't undo: anything they already read or copied.",
  "input_schema": {
    "type": "object",
    "properties": {
      "doc": {
        "type": "string",
        "description": "The doc/file id, or its full Docs/Drive URL."
      },
      "email": {
        "type": "string",
        "description": "Whose access to remove."
      }
    },
    "required": [
      "doc",
      "email"
    ]
  },
  "actionClass": "client_notify",
  "reversible": false,
  "speed": "fast"
}
`;


# ── Secrets (NEVER commit) ──────────────────────────────────────────────
.env*
.env.local
!.env.local.example

# ── Dependencies ────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ── Next.js build output ────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Runtime logs / local state ──────────────────────────────────────────
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor cruft ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Misc ────────────────────────────────────────────────────────────────
/coverage
.vercel

# ── Ruflo local vector-memory DB + runtime state (Wave C-1) ────────────
# Written by `ruflo memory init` + every runtime memory_store call.
# Per-app namespace, never committed (state, not source).
/.claude/memory.db
/.claude/memory.db-*
/.claude/proven-config.json
/.claude/.proven-config-version
/.claude-flow/
/.swarm/
/ruvector.db
/ruvector.db-*

